public class MessageTest {

    // ── Test message objects saved as fields ──────
    // These are saved so tests can access their
    // auto-generated IDs and hashes
    private Message testMsg1;  // Sent
    private Message testMsg2;  // Stored - longest message
    private Message testMsg3;  // Disregarded
    private Message testMsg4;  // Sent
    private Message testMsg5;  // Stored

    // ── @Before runs before EVERY test ────────────
    /**
     * Resets all arrays and loads the 5 test messages
     * from the assignment into the system before each test.
     * This ensures every test starts with a clean, known state.
     */
    @Before
    public void setUp() {
        // Reset all arrays and lists to zero
        Message.resetAll();

        // ── Hard-coded test data from assignment ──

        // Test Message 1: Sent
        testMsg1 = new Message("+27834537896", "Did you get the cake?");
        testMsg1.SentMessage(1);

        // Test Message 2: Stored (longest message)
        testMsg2 = new Message("+27839884567",
                "Where are you? You are late! I have asked you to be on time.");
        testMsg2.SentMessage(3);

        // Test Message 3: Disregarded
        testMsg3 = new Message("+27834485567", "Yohooo, I am at your gate");
        testMsg3.SentMessage(2);

        // Test Message 4: Sent (note: no international code - bypasses validation in tests)
        testMsg4 = new Message("0638884567", "It is dinner time");
        testMsg4.SentMessage(1);

        // Test Message 5: Stored
        testMsg5 = new Message("+27838884567", "Ok, I am leaving without you");
        testMsg5.SentMessage(3);
    }

