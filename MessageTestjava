    /**
     * Test 11: Sent messages array is correctly populated
     * Test Data: Messages 1 and 4 are sent
     * Expected: sentMessagesArray contains correct messages in order
     */
    @Test
    public void testSentMessagesArrayCorrectlyPopulated() {
        // After @Before, sent messages are msg1 and msg4
        // Index 0 should be "Did you get the cake?"
        assertEquals("Did you get the cake?",
                Message.getSentMessagesArray()[0]);

        // Index 1 should be "It is dinner time"
        assertEquals("It is dinner time",
                Message.getSentMessagesArray()[1]);
    }

    /**
     * Test 12: Display longest message
     * Test Data: Messages 1-4
     * Expected: returnSentMessages() contains both sent messages
     * The longest sent message is "Did you get the cake?"
     */
    @Test
    public void testDisplayLongestMessage() {
        // Get all sent messages as a string
        String result = Message.returnSentMessages();

        // Both sent messages should be in the result
        assertTrue(result.contains("Did you get the cake?"));
        assertTrue(result.contains("It is dinner time"));
    }

    /**
     * Test 13: Search for message by ID
     * Test Data: Test Message 4 (ID auto-generated)
     * Expected: returns "It is dinner time"
     */
    @Test
    public void testSearchByMessageID() {
        // Get the auto-generated ID of message 4
        String msg4ID = testMsg4.getMessageID();

        // Search for it and check the result
        String result = Message.searchByMessageID(msg4ID);
        assertEquals("It is dinner time", result);
    }

    /**
     * Test 14: Search messages by recipient
     * Test Data: Recipient of Message 2 (+27839884567)
     * Expected: returns message 2 text
     */
    @Test
    public void testSearchByRecipient() {
        // Search for all messages sent to message 2's recipient
        String result = Message.searchByRecipient("+27839884567");

        // Should return message 2's text
        assertEquals("Where are you? You are late! I have asked you to be on time.",
                result);
    }

    /**
     * Test 15: Delete a message using its hash
     * Test Data: Hash of Message 2
     * Expected: returns confirmation that hash was deleted
     */
    @Test
    public void testDeleteMessageByHash() {
        // Get the auto-generated hash of message 2
        String msg2Hash = testMsg2.getMessageHash();

        // Delete it and check the confirmation message
        String result = Message.deleteByHash(msg2Hash);

        // Result should confirm successful deletion
        assertTrue(result.contains("successfully deleted"));
    }

    /**
     * Test 16: Display report of all stored messages
     * Test Data: Messages 2 and 5 are stored
     * Expected: report contains both stored messages
     */
    @Test
    public void testDisplayReport() {
        // Get the full stored messages report
        String report = Message.displayReport();

        // Report should contain message 2 text
        assertTrue(report.contains(
                "Where are you? You are late! I have asked you to be on time."));

        // Report should contain message 5 text
        assertTrue(report.contains("Ok, I am leaving without you"));
    }

    /**
     * Test 17: Longest stored message is correctly identified
     * Expected: getLongestMessage() returns message 2 (longest stored)
     */
    @Test
    public void testGetLongestStoredMessage() {
        // Message 2 (61 chars) is longer than message 5 (28 chars)
        assertEquals(
                "Where are you? You are late! I have asked you to be on time.",
                Message.getLongestMessage());
    }

